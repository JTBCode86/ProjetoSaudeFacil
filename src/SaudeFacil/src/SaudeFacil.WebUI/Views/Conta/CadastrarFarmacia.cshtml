@model SaudeFacil.Application.DTOs.FarmaciaCadastroDto

@{
    ViewData["Title"] = "Cadastro de Farmácia Partner";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
            <div class="text-center mb-4">
                <div class="d-inline-flex p-3 rounded-circle bg-light text-teal mb-2">
                    <i class="bi bi-shop-window fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark">Cadastrar Farmácia Parceira</h3>
                <p class="text-muted small">Venda seus medicamentos no marketplace e alcance mais clientes no seu bairro</p>
            </div>

            <form asp-action="CadastrarFarmacia" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                <h6 class="fw-bold text-teal mb-3"><i class="bi bi-building me-1"></i> Dados da Empresa</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-12">
                        <label class="form-label">Nome Fantasia da Farmácia</label>
                        <input asp-for="NomeFantasia" class="form-control rounded-3" placeholder="Ex: Drogaria Saúde de Bairro" />
                        <span asp-validation-for="NomeFantasia" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">CNPJ</label>
                        <input asp-for="Cnpj" class="form-control rounded-3" placeholder="00.000.000/0001-00" />
                        <span asp-validation-for="Cnpj" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Telefone Comercial</label>
                        <input asp-for="Telefone" class="form-control rounded-3" placeholder="(11) 3333-4444" />
                        <span asp-validation-for="Telefone" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">E-mail Corporativo</label>
                        <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="contato@farmacia.com.br" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Senha de Acesso</label>
                        <input asp-for="Senha" type="password" class="form-control rounded-3" placeholder="Sua senha secreta" />
                        <span asp-validation-for="Senha" class="text-danger small"></span>
                    </div>
                </div>

                <h6 class="fw-bold text-teal mb-3"><i class="bi bi-geo-alt me-1"></i> Endereço do Estabelecimento</h6>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">CEP</label>
                        <input asp-for="Cep" class="form-control rounded-3" placeholder="00000-000" />
                        <span asp-validation-for="Cep" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Logradouro / Rua</label>
                        <input asp-for="Logradouro" class="form-control rounded-3" placeholder="Rua do Comércio" />
                        <span asp-validation-for="Logradouro" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Número</label>
                        <input asp-for="Numero" class="form-control rounded-3" placeholder="500" />
                        <span asp-validation-for="Numero" class="text-danger small"></span>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">Complemento</label>
                        <input asp-for="Complemento" class="form-control rounded-3" placeholder="Loja 1 / Térreo" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Bairro</label>
                        <input asp-for="Bairro" class="form-control rounded-3" placeholder="Centro" />
                        <span asp-validation-for="Bairro" class="text-danger small"></span>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Cidade</label>
                        <input asp-for="Cidade" class="form-control rounded-3" placeholder="São Paulo" />
                        <span asp-validation-for="Cidade" class="text-danger small"></span>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">UF</label>
                        <input asp-for="Estado" class="form-control rounded-3" placeholder="SP" maxlength="2" />
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-sf-primary w-100 rounded-pill py-2 fw-bold">Cadastrar Farmácia</button>
            </form>
        </div>
    </div>
</div>