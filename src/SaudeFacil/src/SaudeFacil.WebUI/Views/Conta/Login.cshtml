@model SaudeFacil.Application.DTOs.LoginDto

@{
    ViewData["Title"] = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark">Entrar na Conta</h3>
                <p class="text-muted small">Aceda à sua conta de Cliente ou Farmácia</p>
            </div>

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3" role="alert">
                    @TempData["Sucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-3"></div>

                <div class="mb-3">
                    <label class="form-label">E-mail</label>
                    <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="seuemail@exemplo.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label class="form-label">Senha</label>
                    <input asp-for="Senha" type="password" class="form-control rounded-3" placeholder="Sua senha" />
                    <span asp-validation-for="Senha" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-sf-primary w-100 rounded-pill py-2 fw-bold">Entrar</button>
            </form>
        </div>
    </div>
</div>