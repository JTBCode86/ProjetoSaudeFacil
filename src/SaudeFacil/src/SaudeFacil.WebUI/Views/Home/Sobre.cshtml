@{
    ViewData["Title"] = "Sobre Nós";
}

<div class="container py-5">
    <!-- Cabeçalho da Página -->
    <div class="text-center mb-5">
        <h1 class="fw-bold text-dark">Sobre o <span class="text-teal">Saúde Fácil</span></h1>
        <p class="text-muted lead">Conectando você às farmácias de bairro com os melhores preços e agilidade.</p>
    </div>

    <!-- Seção de História / Propósito -->
    <div class="row align-items-center mb-5">
        <div class="col-lg-6 mb-4 mb-lg-0">
            <h3 class="fw-bold mb-3 text-dark">Nossa Missão é Cuidar de Perto</h3>
            <p class="text-secondary">
                O <strong>Saúde Fácil</strong> nasceu com o propósito de valorizar o comércio local de saúde, aproximando os moradores das farmácias de bairro. Acreditamos que encontrar o medicamento ideal pelo preço justo não deve ser uma tarefa complicada.
            </p>
            <p class="text-secondary">
                Através da nossa plataforma, unimos tecnologia de geolocalização e inventário em tempo real para que você encontre o que precisa no seu bairro, com rapidez e economia.
            </p>
        </div>
        <div class="col-lg-6 text-center">
            <div class="p-5 bg-light rounded-4 shadow-sm border">
                <i class="bi bi-heart-pulse-fill text-teal display-1"></i>
                <h4 class="fw-bold mt-3 text-dark">+ de 15 anos transformando</h4>
                <p class="text-muted small mb-0">A experiência de compra e proximidade na saúde local.</p>
            </div>
        </div>
    </div>

    <!-- Cards de Missão, Visão e Valores -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white text-center">
                <div class="d-inline-flex p-3 rounded-circle bg-light text-teal mx-auto mb-3">
                    <i class="bi bi-bullseye fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark">Missão</h4>
                <p class="text-muted small mb-0">
                    Facilitar o acesso a medicamentos e produtos de saúde, fortalecendo as farmácias locais e oferecendo a melhor experiência de busca e proximidade para os clientes.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white text-center">
                <div class="d-inline-flex p-3 rounded-circle bg-light text-teal mx-auto mb-3">
                    <i class="bi bi-eye-fill fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark">Visão</h4>
                <p class="text-muted small mb-0">
                    Ser a principal referência em marketplace de saúde de bairro, reconhecida pela inovação, transparência e pelo impacto positivo na economia local.
                </p>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 bg-white text-center">
                <div class="d-inline-flex p-3 rounded-circle bg-light text-teal mx-auto mb-3">
                    <i class="bi bi-shield-check-fill fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark">Valores</h4>
                <p class="text-muted small mb-0">
                    Transparência nas informações, proximidade com a comunidade, inovação tecnológica constante, ética e compromisso absoluto com a saúde e o bem-estar.
                </p>
            </div>
        </div>
    </div>
</div>