@model List<SaudeFacil.Application.DTOs.ItemCarrinhoDto>

@{
    ViewData["Title"] = "Seu Carrinho";
    decimal subtotal = Model?.Sum(i => i.PrecoUnitario * i.Quantidade) ?? 0m;
}

<div class="container py-3">
    <h2 class="mb-4 fw-bold text-dark"><i class="bi bi-cart3 me-2"></i>Seu Carrinho</h2>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 bg-white rounded-3 shadow-sm">
            <i class="bi bi-cart-x text-muted" style="font-size: 4rem;"></i>
            <h4 class="mt-3 text-secondary">O seu carrinho está vazio</h4>
            <p class="text-muted">Adicione medicamentos para continuar com as suas compras.</p>
            <a asp-controller="Home" asp-action="Buscar" class="btn btn-sf-primary mt-2">
                <i class="bi bi-search me-1"></i> Procurar Medicamentos
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- LISTA DE ITENS -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 text-secondary">Itens Selecionados</h5>
                        <div class="table-responsive">
                            <table class="table align-middle">
                                <thead>
                                    <tr class="text-muted small">
                                        <th>Remédio</th>
                                        <th class="text-center">Preço</th>
                                        <th class="text-center">Qtd</th>
                                        <th class="text-end">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        var codigoAmigavel = item.RemedioId.ToString().Substring(0, 5).ToUpper();
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center gap-3">
                                                    <div class="p-2 bg-light rounded text-teal fs-4">
                                                        <i class="bi bi-capsule"></i>
                                                    </div>
                                                    <div>
                                                        <span class="fw-bold d-block">@(string.IsNullOrEmpty(item.Nome) ? $"Medicamento (Cód. {codigoAmigavel})" : item.Nome)</span>
                                                        <small class="text-muted">Cód. @codigoAmigavel</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center fw-semibold text-secondary">
                                                @item.PrecoUnitario.ToString("C")
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-light text-dark border px-3 py-2 fw-semibold">
                                                    @item.Quantidade
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <form asp-controller="Carrinho" asp-action="Remover" method="post" class="d-inline">
                                                    <input type="hidden" name="remedioId" value="@item.RemedioId" />
                                                    <button type="submit" class="btn btn-outline-danger btn-sm border-0" title="Remover item">
                                                        <i class="bi bi-trash fs-5"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RESUMO E FINALIZAÇÃO DO PEDIDO -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-3 text-secondary">
                            <i class="bi bi-card-checklist me-1"></i> Resumo do Pedido
                        </h5>

                        <form asp-controller="Carrinho" asp-action="FinalizarPedido" method="post">
                            <div class="mb-3">
                                <label class="form-label small fw-semibold text-muted">Tipo de Entrega</label>
                                <select name="tipoEntrega" id="selectTipoEntrega" class="form-select" onchange="calcularTotais()">
                                    <option value="Delivery">Entrega Rápida (Delivery - 5%)</option>
                                    <option value="Retirada">Retirar na Farmácia (Grátis)</option>
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="form-label small fw-semibold text-muted">Forma de Pagamento</label>
                                <select name="formaPagamento" class="form-select">
                                    <option value="PIX">PIX</option>
                                    <option value="CartaoCredito">Cartão de Crédito</option>
                                    <option value="Dinheiro">Dinheiro na Entrega</option>
                                </select>
                            </div>

                            <hr class="my-3" />

                            <!-- VALORES DO PEDIDO -->
                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Subtotal dos produtos:</span>
                                <span class="fw-semibold">@subtotal.ToString("C")</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2 text-muted">
                                <span>Frete / Taxa de Entrega:</span>
                                <span id="lblFrete" class="fw-semibold text-success">R$ 0,00</span>
                            </div>

                            <div class="d-flex justify-content-between my-3 pt-2 border-top fs-5 fw-bold text-dark">
                                <span>Total:</span>
                                <span id="lblTotal" class="text-teal">@subtotal.ToString("C")</span>
                            </div>

                            @if (User.Identity != null && User.Identity.IsAuthenticated)
                            {
                                <button type="submit" class="btn btn-sf-primary w-100 py-2 fw-bold rounded-3">
                                    Confirmar Pedido <i class="bi bi-arrow-right ms-1"></i>
                                </button>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 small mb-3">
                                    <i class="bi bi-info-circle me-1"></i> É necessário iniciar sessão para concluir a compra.
                                </div>
                                <a asp-controller="Conta" asp-action="Login" asp-route-returnUrl="@Url.Action("Index", "Carrinho")" class="btn btn-warning w-100 py-2 fw-bold text-dark rounded-3">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Entrar para Finalizar
                                </a>
                            }
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const subtotal = @subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture);

        function calcularTotais() {
            const tipoEntrega = document.getElementById('selectTipoEntrega').value;
            let frete = 0;

            if (tipoEntrega === 'Delivery') {
                frete = subtotal * 0.05;
            }

            const total = subtotal + frete;

            document.getElementById('lblFrete').innerText = frete.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
            document.getElementById('lblTotal').innerText = total.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        // Executa ao carregar a página
        document.addEventListener('DOMContentLoaded', calcularTotais);
    </script>
}